# RescueNet AI backend configuration TEMPLATE
# Copy to backend/.env (gitignored) for local runs. NEVER commit real values.
# All variables use the RESCUENET_ prefix.

RESCUENET_APP_ENV=dev
RESCUENET_LOG_LEVEL=INFO
RESCUENET_BACKEND_PORT=8000

# --- M3: PostgreSQL event store. Unused at M1; required when app_env=prod. ---
# The application reads ONE variable and is environment-agnostic:
#
#   RESCUENET_DATABASE_URL
#
# Do not hard-code a host here. Credentials live in deploy/.env (single source):
#   container  -> Compose sets it from DATABASE_URL      (host `postgres`)
#   host/tests -> export it from DATABASE_URL_HOST       (host `127.0.0.1`)
#
#   export RESCUENET_DATABASE_URL="$(grep '^DATABASE_URL_HOST=' ../deploy/.env | cut -d= -f2-)"
#
# RESCUENET_DATABASE_URL=

# --- M10: MQTT publisher. Unused at M1; host required when app_env=prod. ---
# RESCUENET_MQTT_HOST=localhost
# RESCUENET_MQTT_PORT=1883
# RESCUENET_MQTT_USERNAME=rescuenet-publisher
# RESCUENET_MQTT_PASSWORD=
