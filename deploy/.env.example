# RescueNet AI — infrastructure configuration TEMPLATE
# Copy to deploy/.env (gitignored) and fill in real values.
# NEVER commit deploy/.env. NEVER put real secrets in this template.

# --- PostgreSQL (docs/07 T-06) ---
POSTGRES_DB=rescuenet
POSTGRES_USER=rescuenet
POSTGRES_PASSWORD=            # REQUIRED — choose a strong value
POSTGRES_PORT=5432

# --- Backend (docs/07 T-05) ---
# Two URLs, ONE set of credentials. They differ only in the host token, because
# the database is reached by a different name from inside and outside Compose.
#
#   DATABASE_URL      host = `postgres`   -> used by the backend CONTAINER
#   DATABASE_URL_HOST host = `127.0.0.1`  -> used by HOST-run pytest and tooling
#
# The application reads exactly one variable, RESCUENET_DATABASE_URL, and never
# knows which environment it is in. Compose supplies it for the container; a host
# shell exports it from DATABASE_URL_HOST (see README).
DATABASE_URL=                 # e.g. postgresql+psycopg://USER:PASSWORD@postgres:5432/rescuenet
DATABASE_URL_HOST=            # e.g. postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/rescuenet
BACKEND_PORT=8000
APP_ENV=dev

# --- Mosquitto (docs/09 AP-23) ---
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_PUBLISHER_USER=rescuenet-publisher
MQTT_PUBLISHER_PASSWORD=      # REQUIRED — must match deploy/mosquitto/passwd
MQTT_DASHBOARD_USER=rescuenet-dashboard
MQTT_DASHBOARD_PASSWORD=      # REQUIRED — must match deploy/mosquitto/passwd

# Health-check account (subscribe-only is sufficient)
MQTT_HEALTH_USER=rescuenet-dashboard
MQTT_HEALTH_PASSWORD=         # same as MQTT_DASHBOARD_PASSWORD
