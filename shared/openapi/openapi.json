{
  "components": {
    "schemas": {
      "AcceptedEvent": {
        "properties": {
          "device_id": {
            "title": "Device Id",
            "type": "integer"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "server_seq": {
            "title": "Server Seq",
            "type": "integer"
          },
          "was_duplicate": {
            "title": "Was Duplicate",
            "type": "boolean"
          }
        },
        "required": [
          "device_id",
          "seq",
          "server_seq",
          "was_duplicate"
        ],
        "title": "AcceptedEvent",
        "type": "object"
      },
      "AssignmentCreate": {
        "additionalProperties": false,
        "properties": {
          "cell_ids": {
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "title": "Cell Ids",
            "type": "array"
          },
          "incident_id": {
            "minimum": 0.0,
            "title": "Incident Id",
            "type": "integer"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "team_id": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "Team Id",
            "type": "integer"
          }
        },
        "required": [
          "team_id",
          "cell_ids",
          "incident_id"
        ],
        "title": "AssignmentCreate",
        "type": "object"
      },
      "AssignmentCreated": {
        "properties": {
          "already_held": {
            "items": {
              "$ref": "#/components/schemas/HeldCell"
            },
            "title": "Already Held",
            "type": "array"
          },
          "assignment_id": {
            "title": "Assignment Id",
            "type": "integer"
          },
          "server_seq": {
            "title": "Server Seq",
            "type": "integer"
          }
        },
        "required": [
          "assignment_id",
          "server_seq",
          "already_held"
        ],
        "title": "AssignmentCreated",
        "type": "object"
      },
      "AssignmentRevoked": {
        "properties": {
          "server_seq": {
            "title": "Server Seq",
            "type": "integer"
          }
        },
        "required": [
          "server_seq"
        ],
        "title": "AssignmentRevoked",
        "type": "object"
      },
      "ComponentStatus": {
        "description": "State of a backing service.\n\n``UNCHECKED`` is the honest value while the component that would perform the\ncheck does not exist yet: the event store arrives at M3 and the MQTT\npublisher at M10 (docs/12). It is deliberately not ``OK`` \u2014 reporting a\ncomponent healthy without checking it would be a fabricated result.",
        "enum": [
          "ok",
          "unchecked",
          "error"
        ],
        "title": "ComponentStatus",
        "type": "string"
      },
      "DeltaPage": {
        "properties": {
          "current_server_seq": {
            "title": "Current Server Seq",
            "type": "integer"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Events",
            "type": "array"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "next_since": {
            "title": "Next Since",
            "type": "integer"
          }
        },
        "required": [
          "events",
          "next_since",
          "has_more",
          "current_server_seq"
        ],
        "title": "DeltaPage",
        "type": "object"
      },
      "DisasterType": {
        "description": "docs/08 \u00a72.1 event 1; the incident types named in PS-B1.",
        "enum": [
          "LANDSLIDE",
          "BUILDING_COLLAPSE",
          "OTHER"
        ],
        "title": "DisasterType",
        "type": "string"
      },
      "EnrolRequest": {
        "additionalProperties": false,
        "properties": {
          "device_label": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Label"
          },
          "join_code": {
            "maxLength": 16,
            "minLength": 1,
            "title": "Join Code",
            "type": "string"
          },
          "mode": {
            "default": "FIELD",
            "pattern": "^(FIELD|GATEWAY)$",
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "join_code"
        ],
        "title": "EnrolRequest",
        "type": "object"
      },
      "EventBatch": {
        "additionalProperties": false,
        "properties": {
          "batch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Id"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "minItems": 1,
            "title": "Events",
            "type": "array"
          },
          "mac": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mac"
          },
          "origin_device_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Device Id"
          }
        },
        "required": [
          "events"
        ],
        "title": "EventBatch",
        "type": "object"
      },
      "GridCreate": {
        "additionalProperties": false,
        "properties": {
          "bearing_deg": {
            "default": 0.0,
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Bearing Deg",
            "type": "number"
          },
          "cell_size_m": {
            "exclusiveMinimum": 0.0,
            "title": "Cell Size M",
            "type": "number"
          },
          "cols": {
            "maximum": 8191.0,
            "minimum": 1.0,
            "title": "Cols",
            "type": "integer"
          },
          "origin_lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Origin Lat",
            "type": "number"
          },
          "origin_lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Origin Lon",
            "type": "number"
          },
          "rows": {
            "maximum": 8191.0,
            "minimum": 1.0,
            "title": "Rows",
            "type": "integer"
          }
        },
        "required": [
          "origin_lat",
          "origin_lon",
          "cell_size_m",
          "rows",
          "cols"
        ],
        "title": "GridCreate",
        "type": "object"
      },
      "GridCreated": {
        "properties": {
          "cell_count": {
            "title": "Cell Count",
            "type": "integer"
          },
          "incident_id": {
            "title": "Incident Id",
            "type": "integer"
          },
          "server_seq": {
            "title": "Server Seq",
            "type": "integer"
          }
        },
        "required": [
          "incident_id",
          "cell_count",
          "server_seq"
        ],
        "title": "GridCreated",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Exactly the three fields docs/09 specifies. No operational data.",
        "properties": {
          "broker": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "db": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "broker"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HeldCell": {
        "properties": {
          "cell_index": {
            "title": "Cell Index",
            "type": "integer"
          },
          "team_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Id"
          }
        },
        "required": [
          "cell_index",
          "team_id"
        ],
        "title": "HeldCell",
        "type": "object"
      },
      "IncidentCreate": {
        "additionalProperties": false,
        "properties": {
          "disaster_type": {
            "$ref": "#/components/schemas/DisasterType"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "origin_lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Origin Lat",
            "type": "number"
          },
          "origin_lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Origin Lon",
            "type": "number"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "name",
          "disaster_type",
          "origin_lat",
          "origin_lon",
          "started_at"
        ],
        "title": "IncidentCreate",
        "type": "object"
      },
      "IncidentCreated": {
        "properties": {
          "incident_id": {
            "title": "Incident Id",
            "type": "integer"
          },
          "server_seq": {
            "title": "Server Seq",
            "type": "integer"
          }
        },
        "required": [
          "incident_id",
          "server_seq"
        ],
        "title": "IncidentCreated",
        "type": "object"
      },
      "IngestResult": {
        "properties": {
          "accepted": {
            "items": {
              "$ref": "#/components/schemas/AcceptedEvent"
            },
            "title": "Accepted",
            "type": "array"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/RejectedEvent"
            },
            "title": "Rejected",
            "type": "array"
          },
          "server_seq_high": {
            "title": "Server Seq High",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "rejected",
          "server_seq_high"
        ],
        "title": "IngestResult",
        "type": "object"
      },
      "JoinCodeRequest": {
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "minimum": 0.0,
            "title": "Incident Id",
            "type": "integer"
          },
          "max_uses": {
            "default": 5,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Uses",
            "type": "integer"
          }
        },
        "required": [
          "incident_id"
        ],
        "title": "JoinCodeRequest",
        "type": "object"
      },
      "RejectedEvent": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq"
          }
        },
        "required": [
          "code",
          "retryable",
          "message"
        ],
        "title": "RejectedEvent",
        "type": "object"
      },
      "SessionRequest": {
        "additionalProperties": false,
        "properties": {
          "incident_id": {
            "minimum": 0.0,
            "title": "Incident Id",
            "type": "integer"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "incident_id",
          "password"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "SyncDiagnostics": {
        "properties": {
          "current_server_seq": {
            "title": "Current Server Seq",
            "type": "integer"
          },
          "events_by_transport": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Events By Transport",
            "type": "object"
          },
          "events_total": {
            "title": "Events Total",
            "type": "integer"
          },
          "last_publish_server_seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Publish Server Seq"
          },
          "mqtt_connected": {
            "title": "Mqtt Connected",
            "type": "boolean"
          },
          "projection_lag": {
            "title": "Projection Lag",
            "type": "integer"
          }
        },
        "required": [
          "current_server_seq",
          "events_total",
          "events_by_transport",
          "projection_lag",
          "mqtt_connected",
          "last_publish_server_seq"
        ],
        "title": "SyncDiagnostics",
        "type": "object"
      },
      "TeamCreate": {
        "additionalProperties": false,
        "properties": {
          "agency_id": {
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Agency Id",
            "type": "integer"
          },
          "agency_type": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Agency Type",
            "type": "string"
          },
          "callsign": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Callsign",
            "type": "string"
          },
          "incident_id": {
            "minimum": 0.0,
            "title": "Incident Id",
            "type": "integer"
          },
          "team_id": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "Team Id",
            "type": "integer"
          }
        },
        "required": [
          "team_id",
          "callsign",
          "agency_id",
          "agency_type",
          "incident_id"
        ],
        "title": "TeamCreate",
        "type": "object"
      },
      "TeamCreated": {
        "properties": {
          "server_seq": {
            "title": "Server Seq",
            "type": "integer"
          },
          "team_id": {
            "title": "Team Id",
            "type": "integer"
          }
        },
        "required": [
          "team_id",
          "server_seq"
        ],
        "title": "TeamCreated",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Multi-agency search-and-rescue coordination. REST is authoritative for all durable writes and reads.",
    "title": "RescueNet AI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the application is serving.\n\n``status`` describes the application process only. ``db`` and ``broker``\nremain ``unchecked`` until M3 and M10 supply components able to check them.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/assignments": {
      "post": {
        "operationId": "issue_assignment_v1_assignments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue an assignment",
        "tags": [
          "assignment"
        ]
      }
    },
    "/v1/assignments/{assignment_id}": {
      "delete": {
        "operationId": "revoke_assignment_v1_assignments__assignment_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "assignment_id",
            "required": true,
            "schema": {
              "title": "Assignment Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "reason",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reason"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentRevoked"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke an assignment",
        "tags": [
          "assignment"
        ]
      }
    },
    "/v1/auth/session": {
      "post": {
        "description": "Authenticated by the incident password (`09` endpoint 2).",
        "operationId": "open_session_v1_auth_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Open Session V1 Auth Session Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Commander dashboard login",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/diag/sync": {
      "get": {
        "operationId": "sync_diagnostics_v1_diag_sync_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncDiagnostics"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sync diagnostics",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/enrol": {
      "post": {
        "description": "Authenticated by the join code itself \u2014 no bearer token (`09` endpoint 1).\n\nDeliberately **non-idempotent**: two enrolments with one code yield two\ndistinct `device_id` values (AP-02, TR-33).",
        "operationId": "enrol_v1_enrol_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrolRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Enrol V1 Enrol Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Device joins an incident with a join code",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "read_events_v1_events_get",
        "parameters": [
          {
            "description": "Cursor \u2014 exclusive lower bound on server_seq",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Cursor \u2014 exclusive lower bound on server_seq",
              "minimum": 0,
              "title": "Since",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "entity_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Type"
            }
          },
          {
            "in": "query",
            "name": "entity_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Id"
            }
          },
          {
            "in": "query",
            "name": "team_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Team Id"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
